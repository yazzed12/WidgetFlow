NODE_ENV=development
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Temporary local-only Express business API configuration. Frontend Auth no
# longer uses this server or its legacy session endpoints.
CLIENT_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=widgetflow_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12
AUTH_INVITATION_TTL_HOURS=72
AUTH_RESET_TTL_MINUTES=30
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT=10
AUTH_TOKEN_RATE_LIMIT=5
AUTH_PUBLIC_URL=http://localhost:5173
